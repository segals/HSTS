<?xml version="1.0" encoding="UTF-8"?>

<!--
    מתווה scenario 1: "לאחר הכניסה מוצג תפריט מתאים לכל משתמשת" -
    after logging in, a menu appropriate to that user is shown.

    The buttons are built in the controller rather than listed here, because
    which ones exist depends on the role of whoever just signed in.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.client.gui.MainMenuController"
      spacing="0" prefWidth="560" prefHeight="560">

    <!-- ===== header ===== -->
    <HBox styleClass="header-bar" spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label fx:id="nameLabel" styleClass="h2"/>
            <Label fx:id="roleLabel" styleClass="caption"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="logoutButton" text="Log out" onAction="#onLogout" styleClass="quiet"/>
    </HBox>

    <!-- ===== body ===== -->
    <VBox spacing="14" VBox.vgrow="ALWAYS">
        <padding><Insets top="18" right="22" bottom="16" left="22"/></padding>

        <VBox styleClass="card" spacing="6">
            <Label text="YOUR COURSES" styleClass="section-title"/>
            <Label fx:id="contextLabel" wrapText="true"/>
        </VBox>

        <Label text="WHAT YOU CAN DO" styleClass="section-title"/>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox fx:id="menuBox" spacing="7"/>
        </ScrollPane>

        <Label fx:id="statusLabel" wrapText="true" text=" "
               styleClass="status" maxWidth="Infinity"/>

        <Label fx:id="footerLabel" wrapText="true" styleClass="caption"/>
    </VBox>

</VBox>
