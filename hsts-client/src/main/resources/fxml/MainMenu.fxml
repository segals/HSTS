<?xml version="1.0" encoding="UTF-8"?>

<!--
    מתווה scenario 1: "לאחר הכניסה מוצג תפריט מתאים לכל משתמשת" -
    after logging in, a menu appropriate to that user is shown.

    The buttons are built in the controller rather than listed here, because
    which ones exist depends on the role of whoever just signed in.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.client.gui.MainMenuController"
      spacing="12" prefWidth="520" prefHeight="460">

    <padding>
        <Insets top="18" right="24" bottom="18" left="24"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label fx:id="nameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="roleLabel" style="-fx-text-fill: #555555;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="logoutButton" text="Log out" onAction="#onLogout"/>
    </HBox>

    <Separator/>

    <Label fx:id="contextLabel" wrapText="true" style="-fx-text-fill: #555555; -fx-font-size: 12px;"/>

    <VBox fx:id="menuBox" spacing="6"/>

    <Region VBox.vgrow="ALWAYS"/>

    <Label fx:id="footerLabel" wrapText="true"
           style="-fx-text-fill: #777777; -fx-font-size: 11px;"/>

</VBox>
