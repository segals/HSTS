<?xml version="1.0" encoding="UTF-8"?>

<!--
    SUC-11 / מתווה scenario 10: a teacher looking at the results of her exams.

      "מורה יכולה לצפות בתוצאות בחינות שכתבה.
       ניתן לראות את הציונים בטבלה וכן בצורת היסטוגרמה."

    Requirement 59 is what decides which exams appear: every exam she WROTE,
    even when another teacher ran it. That is why the sittings list shows who
    released each one - on this screen some of them are somebody else.

    Everything here is read-only. Marking and approving live on the Grading
    screen, under a different rule (the teacher who released it).
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import hsts.client.gui.HistogramView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.client.gui.TeacherReportsController"
      spacing="0" prefWidth="1280" prefHeight="800" minWidth="1040" minHeight="640">

    <HBox styleClass="header-bar" spacing="14" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Results and histogram" styleClass="h2" wrapText="true"/>
            <Label fx:id="subtitleLabel" styleClass="caption" wrapText="true"/>
        </VBox>
        <Button fx:id="backButton" text="Back to menu" onAction="#onBack" styleClass="quiet"/>
    </HBox>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

        <VBox spacing="12" prefWidth="340" minWidth="300">
            <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                <Label text="EXAMS YOU WROTE" styleClass="section-title" wrapText="true"/>
                <ListView fx:id="examList" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                <Label text="SITTINGS" styleClass="section-title" wrapText="true"/>
                <ListView fx:id="sittingList" VBox.vgrow="ALWAYS"/>
                <Label text="Pick a sitting for one class, or the first row for every sitting together."
                       styleClass="caption" wrapText="true"/>
            </VBox>
        </VBox>

        <VBox styleClass="card" spacing="0" HBox.hgrow="ALWAYS" minWidth="560">
            <VBox spacing="3">
                <Label fx:id="titleLabel" styleClass="h3" wrapText="true" maxWidth="Infinity"/>
                <Label fx:id="metaLabel" styleClass="caption" wrapText="true" maxWidth="Infinity"/>
            </VBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox spacing="14">
                    <padding><Insets top="12" right="10" bottom="6" left="0"/></padding>

                    <HBox fx:id="statsRow" spacing="10"/>

                    <VBox spacing="6">
                        <Label text="HOW THE MARKS ARE SPREAD" styleClass="section-title"
                               wrapText="true"/>
                        <HistogramView fx:id="histogram"/>
                    </VBox>

                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="EVERY MARK" styleClass="section-title" wrapText="true"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="tableNoteLabel" styleClass="caption" wrapText="true"/>
                        </HBox>
                        <TableView fx:id="markTable" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="nameColumn"     text="Student"    prefWidth="200"/>
                                <TableColumn fx:id="markColumn"     text="Mark"       prefWidth="70"/>
                                <TableColumn fx:id="autoColumn"     text="System"     prefWidth="70"/>
                                <TableColumn fx:id="changedColumn"  text="Changed by hand" prefWidth="200"/>
                                <TableColumn fx:id="durationColumn" text="Minutes"    prefWidth="80"/>
                                <TableColumn fx:id="statusColumn"   text="State"      prefWidth="130"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>

            <Label fx:id="statusLabel" wrapText="true" text=" "
                   styleClass="status" maxWidth="Infinity"/>
        </VBox>
    </HBox>

</VBox>
