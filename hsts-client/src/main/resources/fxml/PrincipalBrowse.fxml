<?xml version="1.0" encoding="UTF-8"?>

<!--
    SUC-12 / מתווה scenario 11: the principal looking at everything.

      "מנהלת יכולה לראות את מאגר השאלות, המבחנים ותוצאות המבחנים."

    Requirement 62 grants read-only access to all three, so all three are here
    as tabs of one screen rather than three menu entries that each open a
    near-identical window.

    There is no Save, Edit or Delete anywhere on this screen - and more to the
    point, no request behind it that could write. The server has no principal
    path to a write at all.

    Requirement 63 - comparison reports across teachers, courses and students -
    is a different job and arrives with the report factory in milestone 13.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import hsts.client.gui.HistogramView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.client.gui.PrincipalBrowseController"
      spacing="0" prefWidth="1280" prefHeight="800" minWidth="1040" minHeight="640">

    <HBox styleClass="header-bar" spacing="14" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Browse the school's data" styleClass="h2" wrapText="true"/>
            <Label fx:id="subtitleLabel" styleClass="caption" wrapText="true"/>
        </VBox>
        <Button fx:id="backButton" text="Back to menu" onAction="#onBack" styleClass="quiet"/>
    </HBox>

    <TabPane fx:id="tabs" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- ===================== questions ===================== -->
        <Tab text="Question bank">
            <VBox spacing="12">
                <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

                <!-- One filter, not two. There used to be a course box and a
                     search field here as well as the filter bar below, which meant
                     two boxes that both narrowed the same list and neither of which
                     told you what the other was doing. -->
                <HBox spacing="14" VBox.vgrow="ALWAYS">
                    <VBox styleClass="card" spacing="8" prefWidth="430" minWidth="340">
                        <Label text="QUESTIONS" styleClass="section-title" wrapText="true"/>
                        <VBox fx:id="questionButtonHolder" spacing="6"/>
                    <ListView fx:id="questionList" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS" minWidth="420">
                        <Label text="THE QUESTION AS IT STANDS" styleClass="section-title"
                               wrapText="true"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <VBox fx:id="questionDetailBox" spacing="8">
                                <padding><Insets right="10"/></padding>
                            </VBox>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>

        <!-- ===================== exams ===================== -->
        <Tab text="Exams">
            <VBox spacing="12">
                <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

                <HBox spacing="14" VBox.vgrow="ALWAYS">
                    <VBox styleClass="card" spacing="8" prefWidth="420" minWidth="330">
                        <Label text="EVERY EXAM" styleClass="section-title" wrapText="true"/>
                        <VBox fx:id="examButtonHolder" spacing="6"/>
                    <ListView fx:id="examList" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS" minWidth="420">
                        <Label text="THE PAPER" styleClass="section-title" wrapText="true"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <VBox fx:id="examDetailBox" spacing="8">
                                <padding><Insets right="10"/></padding>
                            </VBox>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>

        <!-- ===================== results ===================== -->
        <!-- The school's calendar: every sitting, whenever it was or will be. -->
        <Tab text="School calendar">
            <VBox spacing="12">
                <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

                <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">

                    <!-- One month at a time, with the arrows a wall calendar has.
                         A table sorted by date is a list of dates; a month you can
                         look at answers "how busy is next week" in one glance,
                         which is the question a head teacher actually has. -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="calPrevButton" text="‹" onAction="#onPreviousMonth"
                                styleClass="quiet"/>
                        <Label fx:id="calMonthLabel" styleClass="h3" wrapText="true"
                               minWidth="-Infinity"/>
                        <Button fx:id="calNextButton" text="›" onAction="#onNextMonth"
                                styleClass="quiet"/>
                        <Button fx:id="calTodayButton" text="This month" onAction="#onThisMonth"
                                styleClass="quiet"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="calendarCountLabel" styleClass="caption" wrapText="true"/>
                    </HBox>

                    <VBox fx:id="calendarFilterHolder" spacing="6"/>

                    <HBox spacing="14" VBox.vgrow="ALWAYS">

                        <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="520">
                            <GridPane fx:id="calendarHeadingRow" hgap="6"/>
                            <ScrollPane fitToWidth="true" fitToHeight="true"
                                        VBox.vgrow="ALWAYS" styleClass="cal-scroll">
                                <GridPane fx:id="calendarGrid" hgap="6" vgap="6"
                                          minHeight="380"/>
                            </ScrollPane>
                            <Label fx:id="calendarHintLabel" styleClass="caption" wrapText="true"/>
                        </VBox>

                        <VBox styleClass="card" spacing="8" prefWidth="330" minWidth="270"
                              maxWidth="380">
                            <Label text="THE DAY YOU PICKED" styleClass="section-title"
                                   wrapText="true"/>
                            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                                <VBox fx:id="calendarDetailBox" spacing="8">
                                    <padding><Insets right="10"/></padding>
                                </VBox>
                            </ScrollPane>
                        </VBox>
                    </HBox>

                    <Label text="Past, present and future. Nothing is hidden - a calendar that dropped last term would be a diary rather than a register."
                           styleClass="caption" wrapText="true"/>
                </VBox>
            </VBox>
        </Tab>

        <!-- What the staff have been doing, newest first. -->
        <Tab text="Recent activity">
            <VBox spacing="12">
                <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

                <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="WHAT THE STAFF HAVE DONE" styleClass="section-title"
                               wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="activityCountLabel" styleClass="caption" wrapText="true"/>
                    </HBox>

                    <VBox fx:id="activityFilterHolder" spacing="6"/>

                    <TableView fx:id="activityTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="actWhenColumn"   text="When"   prefWidth="160"
                                         minWidth="120"/>
                            <TableColumn fx:id="actWhoColumn"    text="Who"    prefWidth="160"
                                         minWidth="110"/>
                            <TableColumn fx:id="actRoleColumn"   text="Role"   prefWidth="120"
                                         minWidth="90"/>
                            <TableColumn fx:id="actWhatColumn"   text="What"   prefWidth="230"
                                         minWidth="130"/>
                            <TableColumn fx:id="actDetailColumn" text="Detail" prefWidth="420"
                                         minWidth="150"/>
                        </columns>
                    </TableView>

                    <Label text="Teachers and subject coordinators only, and only actions that changed something. A student's exam is recorded on her own paper, and the principal changes nothing herself."
                           styleClass="caption" wrapText="true"/>
                </VBox>
            </VBox>
        </Tab>

        <Tab text="Results">
            <HBox spacing="14">
                <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

                <VBox spacing="12" prefWidth="330" minWidth="290">
                    <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                        <Label text="EXAMS THAT WERE SAT" styleClass="section-title"
                               wrapText="true"/>
                        <ListView fx:id="resultExamList" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                        <Label text="SITTINGS" styleClass="section-title" wrapText="true"/>
                        <ListView fx:id="resultSittingList" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>

                <VBox styleClass="card" spacing="0" HBox.hgrow="ALWAYS" minWidth="560">
                    <VBox spacing="3">
                        <Label fx:id="resultTitleLabel" styleClass="h3" wrapText="true"
                               maxWidth="Infinity"/>
                        <Label fx:id="resultMetaLabel" styleClass="caption" wrapText="true"
                               maxWidth="Infinity"/>
                    </VBox>

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                        <VBox spacing="14">
                            <padding><Insets top="12" right="10" bottom="6" left="0"/></padding>

                            <HBox fx:id="resultStatsRow" spacing="10"/>

                            <VBox spacing="6">
                                <Label text="HOW THE MARKS ARE SPREAD"
                                       styleClass="section-title" wrapText="true"/>
                                <HistogramView fx:id="resultHistogram"/>
                            </VBox>

                            <VBox spacing="6">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="EVERY MARK" styleClass="section-title"
                                           wrapText="true"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="resultNoteLabel" styleClass="caption"
                                           wrapText="true"/>
                                </HBox>
                                <TableView fx:id="resultTable" prefHeight="260">
                                    <columns>
                                        <TableColumn fx:id="rName"     text="Student" prefWidth="200"/>
                                        <TableColumn fx:id="rMark"     text="Mark"    prefWidth="70"/>
                                        <TableColumn fx:id="rAuto"     text="System"  prefWidth="70"/>
                                        <TableColumn fx:id="rCourse"   text="Course"  prefWidth="160"/>
                                        <TableColumn fx:id="rDuration" text="Minutes" prefWidth="80"/>
                                        <TableColumn fx:id="rStatus"   text="State"   prefWidth="130"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </HBox>
        </Tab>
    </TabPane>

    <Label fx:id="statusLabel" wrapText="true" text=" " styleClass="status"
           maxWidth="Infinity">
        <padding><Insets top="6" right="18" bottom="10" left="18"/></padding>
    </Label>

</VBox>
