<?xml version="1.0" encoding="UTF-8"?>

<!--
    A member of staff's own to-do list.

    Two groups, because they are not the same thing: what she has to do, and what
    she is waiting on somebody else for. The second is there because "where is my
    exam" is a question this list should answer, not one it should leave her to go
    and find out.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.client.gui.TodoController"
      spacing="0" prefWidth="760" prefHeight="640" minWidth="560" minHeight="440">

    <HBox styleClass="header-bar" spacing="14" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="My to-do list" styleClass="h2" wrapText="true"/>
            <Label fx:id="subtitleLabel" styleClass="caption" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="backButton" text="Back to menu" onAction="#onBack" styleClass="quiet"
                minWidth="-Infinity"/>
    </HBox>

    <VBox spacing="14" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox spacing="14">
                <padding><Insets top="0" right="10" bottom="6" left="0"/></padding>

                <VBox fx:id="mineBox" styleClass="card" spacing="10">
                    <Label text="WAITING FOR YOU" styleClass="section-title" wrapText="true"/>
                    <VBox fx:id="mineRows" spacing="8"/>
                </VBox>

                <VBox fx:id="othersBox" styleClass="card" spacing="10"
                      visible="false" managed="false">
                    <Label text="WAITING FOR SOMEBODY ELSE" styleClass="section-title"
                           wrapText="true"/>
                    <VBox fx:id="othersRows" spacing="8"/>
                </VBox>

                <Label fx:id="emptyLabel" wrapText="true" visible="false" managed="false"/>
            </VBox>
        </ScrollPane>

        <Label fx:id="statusLabel" wrapText="true" text=" "
               styleClass="status" maxWidth="Infinity"/>
    </VBox>

</VBox>
