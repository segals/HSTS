<?xml version="1.0" encoding="UTF-8"?>

<!--
    SUC-6 / מתווה scenario 5: taking an exam out of the drawer.

      1. only an APPROVED exam may be released
      2. the teacher sets the opening and closing moments
      3. the teacher sets a 4-character execution code

    The same exam may be released many times (requirement 36) - a second class,
    a re-sit, a different date - and each release is its own sitting with its own
    code, window and results.

    The closing moment is a deadline to START, not to finish. A student who
    begins at 11:55 with 90 minutes allowed works until 13:25.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.client.gui.ExamReleaseController"
      spacing="0" prefWidth="1240" prefHeight="760" minWidth="1000" minHeight="600">

    <!-- ===================== header ===================== -->
    <HBox styleClass="header-bar" spacing="14" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Release an exam" styleClass="h2"/>
            <Label fx:id="subtitleLabel" styleClass="caption"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="backButton" text="Back to menu" onAction="#onBack" styleClass="quiet"/>
    </HBox>

    <!-- ===================== body ===================== -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

        <!-- ===== approved exams ===== -->
        <VBox styleClass="card" spacing="10" prefWidth="330" minWidth="280" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="READY TO RELEASE" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="releasableCountLabel" styleClass="caption"/>
            </HBox>
            <ListView fx:id="approvedList" VBox.vgrow="ALWAYS"/>
            <Label text="Only approved versions appear here. An exam needs the coordinator's approval first."
                   styleClass="caption" wrapText="true"/>
        </VBox>

        <!-- ===== the release form ===== -->
        <VBox styleClass="card" spacing="0" prefWidth="430" minWidth="380">

            <VBox spacing="3">
                <Label fx:id="chosenExamLabel" styleClass="h3"/>
                <Label fx:id="chosenExamMetaLabel" styleClass="caption" wrapText="true"/>
            </VBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox spacing="14">
                    <padding><Insets top="14" right="10" bottom="14" left="0"/></padding>

                    <VBox spacing="6">
                        <Label text="STUDENTS MAY START FROM" styleClass="section-title"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <DatePicker fx:id="openDate" prefWidth="150"/>
                            <Spinner fx:id="openHour" prefWidth="72" editable="true"/>
                            <Label text=":"/>
                            <Spinner fx:id="openMinute" prefWidth="72" editable="true"/>
                            <Button fx:id="nowButton" text="Now" onAction="#onSetNow"
                                    styleClass="quiet"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="AND UNTIL" styleClass="section-title"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <DatePicker fx:id="closeDate" prefWidth="150"/>
                            <Spinner fx:id="closeHour" prefWidth="72" editable="true"/>
                            <Label text=":"/>
                            <Spinner fx:id="closeMinute" prefWidth="72" editable="true"/>
                        </HBox>
                        <Label text="This is the deadline to START. A student who begins just before it still gets her full time."
                               styleClass="caption" wrapText="true"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="EXECUTION CODE" styleClass="section-title"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="codeField" prefWidth="120" promptText="e.g. K7M2"/>
                            <Button fx:id="generateButton" text="Generate" onAction="#onGenerate"/>
                        </HBox>
                        <Label text="4 letters or digits. You read it out to the class; capitals do not matter."
                               styleClass="caption" wrapText="true"/>
                    </VBox>

                    <GridPane hgap="14" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150"/>
                            <ColumnConstraints minWidth="150"/>
                        </columnConstraints>

                        <Label text="MINUTES ALLOWED" styleClass="section-title"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label text="ATTEMPTS ALLOWED" styleClass="section-title"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Spinner fx:id="durationSpinner" editable="true" prefWidth="130"
                                 GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Spinner fx:id="attemptsSpinner" editable="true" prefWidth="130"
                                 GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </ScrollPane>

            <!-- pinned footer -->
            <VBox spacing="8">
                <padding><Insets top="12" right="0" bottom="0" left="0"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="releaseButton" text="Release to a class" onAction="#onRelease"
                            styleClass="primary" prefWidth="170"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="statusLabel" wrapText="true" text=" "
                       styleClass="status" maxWidth="Infinity"/>
            </VBox>
        </VBox>

        <!-- ===== what is already out ===== -->
        <VBox styleClass="card" spacing="10" prefWidth="330" minWidth="280" HBox.hgrow="ALWAYS">
            <Label text="ALREADY RELEASED BY YOU" styleClass="section-title"/>
            <ListView fx:id="executionList" VBox.vgrow="ALWAYS"/>
            <Label text="The same exam can be released more than once - a second class, or a re-sit."
                   styleClass="caption" wrapText="true"/>
        </VBox>
    </HBox>

</VBox>
