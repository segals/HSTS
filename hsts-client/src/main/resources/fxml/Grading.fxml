<?xml version="1.0" encoding="UTF-8"?>

<!--
    SUC-9 / מתווה scenario 8: marking exams.

      1. the system marks and gives a mark
      2. the teacher approves it
      3. the teacher may change a mark - with a reason

    Requirement 52 makes the reason compulsory. Requirement 53 means nothing
    reaches the student until Approve is pressed. Requirement 55 keeps the
    statistics on this screen and off hers.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.client.gui.GradingScreenController"
      spacing="0" prefWidth="1280" prefHeight="780" minWidth="1040" minHeight="620">

    <HBox styleClass="header-bar" spacing="14" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Mark and approve" styleClass="h2" wrapText="true"/>
            <Label fx:id="subtitleLabel" styleClass="caption" wrapText="true"/>
        </VBox>
        <Button fx:id="backButton" text="Back to menu" onAction="#onBack" styleClass="quiet"/>
    </HBox>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

        <!-- sittings, then the students in one -->
        <VBox spacing="12" prefWidth="330" minWidth="290">
            <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                <Label text="SITTINGS WITH PAPERS" styleClass="section-title" wrapText="true"/>
                <ListView fx:id="sittingList" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="STUDENTS" styleClass="section-title" wrapText="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statsLabel" styleClass="caption" wrapText="true"/>
                </HBox>
                <ListView fx:id="studentList" VBox.vgrow="ALWAYS"/>
                <HBox spacing="7">
                    <Button fx:id="approveAllButton" text="Approve all" onAction="#onApproveAll"/>
                    <Spinner fx:id="factorSpinner" editable="true" prefWidth="80"/>
                    <Button fx:id="factorButton" text="Factor" onAction="#onFactor"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- the paper -->
        <VBox styleClass="card" spacing="0" HBox.hgrow="ALWAYS" minWidth="480">
            <VBox spacing="4">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="paperTitleLabel" styleClass="h3" wrapText="true"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label fx:id="markLabel"
                           style="-fx-font-size: 28px; -fx-font-weight: 600;" wrapText="true"/>
                </HBox>
                <Label fx:id="paperMetaLabel" styleClass="caption" wrapText="true"/>
            </VBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="questionBox" spacing="12">
                    <padding><Insets top="12" right="10" bottom="12" left="0"/></padding>
                </VBox>
            </ScrollPane>

            <VBox spacing="8">
                <padding><Insets top="12" right="0" bottom="0" left="0"/></padding>

                <Label text="CHANGE THE MARK  ·  A REASON IS REQUIRED"
                       styleClass="section-title" wrapText="true"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Spinner fx:id="markSpinner" editable="true" prefWidth="90"/>
                    <TextField fx:id="reasonField" promptText="Why is the mark being changed?"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="changeButton" text="Save mark" onAction="#onChangeMark"/>
                </HBox>

                <Label text="COMMENT FOR THE STUDENT" styleClass="section-title" wrapText="true"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextArea fx:id="generalCommentArea" prefRowCount="2" wrapText="true"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="commentButton" text="Save comment" onAction="#onSaveComment"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="approveButton" text="Approve and publish" onAction="#onApprove"
                            styleClass="primary" prefWidth="180"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label fx:id="statusLabel" wrapText="true" text=" "
                       styleClass="status" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </HBox>

</VBox>
