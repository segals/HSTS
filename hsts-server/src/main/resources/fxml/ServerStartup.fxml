<?xml version="1.0" encoding="UTF-8"?>

<!--
    The server's startup window.

    Required by מתווה item 15 - "שרת-לקוח, מחשבים נפרדים, הרצת Jar, GUI לאתחול הקשר":
    the connection details must be entered through a GUI, not hard-coded and not
    passed on a command line.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.server.gui.ServerStartupController"
      alignment="CENTER" spacing="0" prefWidth="480">

    <padding><Insets top="26" right="26" bottom="22" left="26"/></padding>

    <VBox styleClass="card" spacing="18" maxWidth="Infinity">

        <VBox spacing="3">
            <Label text="HSTS Server" styleClass="h1"/>
            <Label text="High School Test System  ·  Group 1" styleClass="muted"/>
        </VBox>

        <VBox spacing="8">
            <Label text="NETWORK" styleClass="section-title"/>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints minWidth="240" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Listening port" styleClass="field-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="serverPortField" promptText="5555"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <VBox spacing="8">
            <Label text="DATABASE" styleClass="section-title"/>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints minWidth="240" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="MySQL host" styleClass="field-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="dbHostField" promptText="localhost"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="MySQL port" styleClass="field-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="dbPortField" promptText="3306"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Database" styleClass="field-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="dbNameField" promptText="hsts"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="User" styleClass="field-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="dbUserField" promptText="root"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Password" styleClass="field-label"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <PasswordField fx:id="dbPasswordField"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <CheckBox fx:id="saveSettingsBox" selected="true"
                      text="Remember these settings"/>
            <Label text="Saved to %USERPROFILE%\.hsts\config.properties - outside the repository, so no secret can be committed."
                   styleClass="caption" wrapText="true"/>
        </VBox>

        <HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="startButton" text="Start server" onAction="#onStart"
                    styleClass="primary" defaultButton="true" prefWidth="150"/>
        </HBox>

        <Label fx:id="statusLabel" wrapText="true" text=" "
               styleClass="status" maxWidth="Infinity"/>
    </VBox>

</VBox>
