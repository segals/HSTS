<?xml version="1.0" encoding="UTF-8"?>

<!-- Shown once the server is listening. Live log of connections and requests. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hsts.server.gui.ServerConsoleController"
      spacing="0" prefWidth="780" prefHeight="500">

    <HBox styleClass="header-bar" spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="HSTS Server" styleClass="h2"/>
            <Label text="running" styleClass="badge-current"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

        <VBox styleClass="card" spacing="4">
            <Label text="STATUS" styleClass="section-title"/>
            <Label fx:id="detailsLabel" wrapText="true"/>
        </VBox>

        <Label text="ACTIVITY" styleClass="section-title"/>
        <TextArea fx:id="logArea" editable="false" wrapText="true"
                  styleClass="mono" VBox.vgrow="ALWAYS"/>
    </VBox>

</VBox>
